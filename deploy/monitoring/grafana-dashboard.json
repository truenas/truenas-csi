{
  "title": "TrueNAS CSI Driver",
  "uid": "truenas-csi",
  "tags": ["truenas", "csi", "storage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(truenas_csi_grpc_requests_total, namespace)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "TrueNAS API connection",
      "description": "1 while the WebSocket to TrueNAS is connected. A driver that cannot reach the appliance provisions nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Disconnected", "color": "red", "index": 0 },
                "1": { "text": "Connected", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(truenas_csi_api_connected{namespace=~\"$namespace\"})",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API reconnects (1h)",
      "description": "Repeated reconnects mean a flapping link or an appliance under pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(truenas_csi_api_reconnects_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "reconnects"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed CSI calls (5m)",
      "description": "Any non-OK gRPC status returned by the driver. Aborted is normal in small numbers: it is how CSI reports an operation already in progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(truenas_csi_grpc_requests_total{namespace=~\"$namespace\", code!=\"OK\"}[5m]))",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CSI calls by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(truenas_csi_grpc_requests_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CSI failures by method and status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, code) (rate(truenas_csi_grpc_requests_total{namespace=~\"$namespace\", code!=\"OK\"}[5m]))",
          "legendFormat": "{{method}} {{code}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CSI call latency (p95)",
      "description": "Volume creation and deletion wait on ZFS, so minutes are not necessarily a fault.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(truenas_csi_grpc_request_duration_seconds_bucket{namespace=~\"$namespace\"}[10m])))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Volume operations by protocol",
      "description": "Whether failures follow one protocol. Deletes of volumes TrueNAS no longer has are labelled unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, operation, status) (increase(truenas_csi_volume_operations_total{namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "{{protocol}} {{operation}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TrueNAS API call latency (p95)",
      "description": "The usual reason a PVC is slow rather than failed. Includes any wait for a reconnect.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (method, le) (rate(truenas_csi_api_call_duration_seconds_bucket{namespace=~\"$namespace\"}[10m]))))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed TrueNAS API calls",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(truenas_csi_api_calls_total{namespace=~\"$namespace\", status=\"error\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CSI sidecar operations (p95)",
      "description": "Measured by the sidecars on ports 8081-8084, so it also covers calls that never reached the driver.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (method_name, le) (rate(csi_sidecar_operations_seconds_bucket{namespace=~\"$namespace\", driver_name=~\".*truenas.*\"}[10m])))",
          "legendFormat": "{{method_name}}"
        }
      ]
    }
  ]
}
